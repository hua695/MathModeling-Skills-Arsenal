% ============================================================
%  8. 改造版 \figplot（符合 figure_policy 反浮动规范）
%
%  与 ModelingPaperKit 原版的区别：
%  - 用 [!htbp] 而非 [H]（figure_policy 禁止 [H] 锁浮动）
%  - 图宽 0.76\textwidth（figure_policy 推荐 0.6-0.85）
%  - 浮动参数与 figure_policy.md 一致
%
%  用法：\figplot{题注}{label}{文件名}{制图说明(可空)}
% ============================================================
\NewDocumentCommand{\figplot}{mmmm}{%
  \begin{figure}[!htbp]
    \centering
    \def\pkbFigPath{}%
    \IfFileExists{#3}{\edef\pkbFigPath{#3}}{}%
    \IfFileExists{./figures/#3}{%
      \ifx\pkbFigPath\empty\edef\pkbFigPath{./figures/#3}\fi
    }{}%
    \IfFileExists{../02_figures/#3}{%
      \ifx\pkbFigPath\empty\edef\pkbFigPath{../02_figures/#3}\fi
    }{}%
    \ifx\pkbFigPath\empty
      \fbox{%
        \parbox[c][0.3\textheight][c]{0.76\textwidth}{%
          \centering
          {\heiti #1}\\[0.8em]
          {\small 图片占位：#3}%
        }%
      }%
    \else
      \includegraphics[width=0.76\textwidth]{\pkbFigPath}%
    \fi
    \caption{#1}%
    \ifblank{#4}{}{%
      \begingroup
      \setlength{\parindent}{0pt}%
      \vspace{0.35em}%
      \noindent{\heiti 制图说明：}{\small #4}\par
      \endgroup
    }%
    \label{#2}%
  \end{figure}%
}

