{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reader-first visual argument plan",
  "type": "object",
  "required": ["schema_version", "status", "prepared_by", "source_node", "scope", "subproblems", "coverage_summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reader_evidence_version": {"const": "1.0"},
    "status": {"enum": ["draft", "approved", "complete"]},
    "prepared_by": {"const": "h7-figure-agent"},
    "source_node": {"const": "H7"},
    "scope": {
      "type": "object",
      "required": ["subproblems", "cross_question_dependencies"],
      "properties": {
        "subproblems": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^Q[0-9]+$"}},
        "cross_question_dependencies": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "global_visual_slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
    "subproblems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subproblem_id", "complexity", "reader_question", "visual_audit"],
        "properties": {
          "subproblem_id": {"type": "string", "pattern": "^Q[0-9]+$"},
          "complexity": {"enum": ["simple", "standard", "complex"]},
          "reader_question": {"type": "string", "minLength": 1},
          "visual_audit": {
            "type": "array",
            "minItems": 6,
            "items": {"$ref": "#/$defs/slot"}
          }
        },
        "additionalProperties": true
      }
    },
    "coverage_summary": {
      "type": "object",
      "required": ["required_visual_slots", "required_figure_slots", "planned_figure_count"],
      "properties": {
        "required_visual_slots": {"type": "integer", "minimum": 0},
        "required_figure_slots": {"type": "integer", "minimum": 0},
        "planned_figure_count": {"type": "integer", "minimum": 0},
        "table_justified_slots": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["slot_id", "category", "disposition", "reader_question", "reader_gain", "evidence_refs", "planned_figure_ids"],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["required", "recommended", "table_justified", "text_sufficient", "not_applicable"]},
        "reader_question": {"type": "string", "minLength": 1},
        "reader_gain": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "planned_figure_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "table_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "information_unit_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "figure_intent": {"$ref": "#/$defs/figure_intent"},
        "representation": {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": {"enum": ["figure", "table", "text"]},
            "reason": {"type": "string", "minLength": 1},
            "pre_text_role": {"type": "string", "minLength": 1},
            "post_text_role": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "density_profile": {"enum": ["standard", "compact"]},
        "compact_figure_reason": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "deferred_reason": {"type": "string", "minLength": 1},
        "table_justification": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": ["planned_figure_ids"],
                "properties": {"planned_figure_ids": {"minItems": 1}}
              },
              {
                "required": ["representation"],
                "properties": {
                  "representation": {
                    "required": ["mode"],
                    "properties": {"mode": {"const": "figure"}}
                  }
                }
              }
            ]
          },
          "then": {"required": ["figure_intent"]}
        }
      ],
      "additionalProperties": true
    },
    "figure_intent": {
      "type": "object",
      "required": [
        "reader_question",
        "explanatory_relation",
        "must_show",
        "must_not_show",
        "body_anchor",
        "pre_text_function",
        "post_text_function",
        "generation_route",
        "template_status",
        "template_id",
        "visible_element_map",
        "canvas_profile"
      ],
      "properties": {
        "reader_question": {"type": "string", "minLength": 1},
        "explanatory_relation": {"type": "string", "minLength": 1},
        "must_show": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "must_not_show": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "body_anchor": {"type": "string", "minLength": 1},
        "pre_text_function": {"type": "string", "minLength": 1},
        "post_text_function": {"type": "string", "minLength": 1},
        "generation_route": {
          "enum": [
            "modelviz",
            "tech-route-maker",
            "tikz-scientific-figures",
            "drawio-diagram"
          ]
        },
        "template_status": {
          "enum": ["native", "external_adapted", "custom_required"]
        },
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "visible_element_map": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/visible_element"}
        },
        "canvas_profile": {
          "$ref": "#/$defs/canvas_profile"
        }
      },
      "additionalProperties": true
    },
    "visible_element": {
      "type": "object",
      "required": ["element", "role", "evidence_refs"],
      "properties": {
        "element": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "canvas_profile": {
      "type": "object",
      "required": ["orientation", "target_layout", "top_level_node_limit"],
      "properties": {
        "orientation": {"enum": ["horizontal", "vertical", "square"]},
        "target_layout": {"enum": ["single", "side_by_side", "wrap_short", "tall_constrained"]},
        "top_level_node_limit": {"type": "integer", "minimum": 2, "maximum": 12},
        "width_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    }
  }
}
