{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Derivation Registry",
  "type": "object",
  "required": ["schema_version", "equations"],
  "properties": {
    "schema_version": {"type": "string"},
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["derived", "given", "cited", "definition"]},
          "label": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "derivation_steps": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "symbols": {"type": "array", "items": {"type": "string"}},
          "citation_keys": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
