{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaTeX appendix evidence contract",
  "type": "object",
  "required": ["schema_version", "source_inputs", "required_appendix_ids"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "required_appendix_ids": {
      "type": "array",
      "items": {"enum": ["A", "B", "C"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "source_inputs": {
      "type": "object",
      "required": ["program_used", "full_source_files", "long_derivation_files", "raw_data_files", "support_material_files"],
      "properties": {
        "program_used": {"type": "boolean"},
        "appendix_code_mode": {"enum": ["not_applicable", "core_only", "full_source"]},
        "core_source_files": {"type": "array", "items": {"type": "string"}},
        "full_source_files": {"type": "array", "items": {"type": "string"}},
        "support_source_files": {"type": "array", "items": {"type": "string"}},
        "long_derivation_files": {"type": "array", "items": {"type": "string"}},
        "raw_data_files": {"type": "array", "items": {"type": "string"}},
        "support_material_files": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
