{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contest run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "command", "inputs", "outputs", "exit_code", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,63}$"},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "command": {
      "type": "object",
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string"}
      }
    },
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "code": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "configs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "seed": {"type": ["integer", "string", "null"]},
    "environment": {"type": "object"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "exit_code": {"type": "integer"},
    "stdout_log": {"type": ["string", "null"]},
    "stderr_log": {"type": ["string", "null"]}
    ,"reproducibility": {
      "type": "object",
      "required": ["entrypoint", "inputs", "parameters", "seed", "command", "outputs", "figure_scripts", "result_paper_map"],
      "properties": {
        "entrypoint": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "parameters": {"type": "array"},
        "seed": {"type": ["integer", "string", "null"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "figure_scripts": {"type": "array", "items": {"type": "string"}},
        "result_paper_map": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "evidence_id"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_id": {"type": "string", "pattern": "^ev:[A-Za-z0-9_.-]+$"},
        "role": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "kind", "source_ids"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev:[A-Za-z0-9_.-]+$"},
        "kind": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "claim": {"type": "string"}
      }
    }
  }
}
