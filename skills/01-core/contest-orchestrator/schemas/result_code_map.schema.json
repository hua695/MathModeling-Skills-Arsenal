{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {"required": ["checks"]},
    {"required": ["derived_checks"]}
  ],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["result_file", "code_file", "code_variable", "json_pointer"],
        "properties": {
          "result_file": {"type": "string"},
          "code_file": {"type": "string"},
          "code_variable": {"type": "string"},
          "json_pointer": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "derived_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["result_file", "target_pointer", "input_pointers", "operation"],
        "properties": {
          "result_file": {"type": "string"},
          "target_pointer": {"type": "string"},
          "input_pointers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "operation": {"enum": ["sum", "product", "mean", "difference", "ratio"]},
          "tolerance": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
