{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declarative dimensional consistency section",
  "type": "object",
  "properties": {
    "dimensions": {
      "type": "object",
      "required": ["symbols", "equations"],
      "properties": {
        "required": {"type": "boolean"},
        "symbols": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1}},
        "equations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lhs", "rhs_terms", "operation"],
            "properties": {
              "lhs": {"type": "string"},
              "rhs_terms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "operation": {"enum": ["same", "add", "multiply", "divide"]}
            }
          }
        }
      }
    }
  }
}
