{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project appendix evidence plan",
  "type": "object",
  "required": ["schema_version", "subproblems", "appendix_modules"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "status": {"enum": ["DRAFT", "READY", "BLOCKED"]},
    "problem_profile": {"type": "string"},
    "official_format": {
      "type": "object",
      "properties": {
        "numbering": {"type": "string"},
        "appendix_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z]$"},
          "uniqueItems": true
        },
        "order": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "subproblems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "primary_type", "capabilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q[0-9]+$"},
          "primary_type": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "result_sources": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "appendix_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "kind", "used_by", "required"],
        "properties": {
          "module_id": {"type": "string"},
          "kind": {"type": "string"},
          "used_by": {"type": "array", "items": {"type": "string"}},
          "required": {"type": "boolean"},
          "source_files": {"type": "array", "items": {"type": "string"}},
          "paper_anchor": {"type": "string"},
          "include_in_pdf": {"type": "boolean"},
          "paper_role": {"type": "string"},
          "support_materials": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "source_inputs": {
      "type": "object",
      "properties": {
        "program_used": {"type": "boolean"},
        "appendix_code_mode": {"enum": ["not_applicable", "core_only", "full_source"]},
        "core_source_files": {"type": "array", "items": {"type": "string"}},
        "full_source_files": {"type": "array", "items": {"type": "string"}},
        "support_source_files": {"type": "array", "items": {"type": "string"}},
        "long_derivation_files": {"type": "array", "items": {"type": "string"}},
        "raw_data_files": {"type": "array", "items": {"type": "string"}},
        "support_material_files": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "entrypoints": {"type": "array", "items": {"type": "string"}},
        "run_commands": {"type": "array", "items": {"type": "string"}},
        "environment_files": {"type": "array", "items": {"type": "string"}},
        "random_seeds": {"type": "array"},
        "expected_outputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
